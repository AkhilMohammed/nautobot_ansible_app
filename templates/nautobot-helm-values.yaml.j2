# Nautobot Helm Values - Generated by Ansible
# Auto-generated from group_vars/onprem/nautobot.yml

# Nautobot Configuration
nautobot:
  secretKey: "{{ vault_nautobot_secret_key }}"
  superuserUsername: "{{ vault_nautobot_superuser_username }}"
  superuserPassword: "{{ vault_nautobot_superuser_password }}"
  superuserEmail: "{{ vault_nautobot_superuser_email }}"
  
  # Plugin Configuration - Dynamically generated from nautobot_git_packages
  plugins:
    enabled: {{ (nautobot_git_packages | default([]) | length > 0) | lower }}
{% if nautobot_git_packages is defined and nautobot_git_packages | length > 0 %}
    packages:
{% for plugin in nautobot_git_packages %}
      - name: "{{ plugin.name }}"  # Git URL: git+https://...
        module: "{{ plugin.module_name }}"  # Python module for PLUGINS list
        version: ""  # Git URL includes version via @branch
{% endfor %}
    config:
{% for plugin_name, plugin_config in (nautobot_plugins_config | default({})).items() %}
      {{ plugin_name }}: {{ plugin_config | to_nice_json }}
{% endfor %}
{% else %}
    packages: []
    config: {}
{% endif %}

# Database Configuration
database:
  host: nautobot-postgresql
  port: 5432
  name: {{ vault_database_name }}
  engine: django.db.backends.postgresql
  existingSecret: nautobot-secrets
  usernameKey: db-user
  passwordKey: db-password

# PostgreSQL Configuration
postgresql:
  enabled: true
  image:
    repository: postgres
    tag: "15-alpine"
  service:
    type: ClusterIP
    port: 5432
  persistence:
    enabled: true
    size: 20Gi
    storageClass: "local-path"
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      cpu: 2000m
      memory: 2Gi

# Redis Configuration  
redis:
  host: nautobot-redis
  port: 6379
  database: 0
  existingSecret: nautobot-secrets
  passwordKey: redis-password
  enabled: true
  replicas: 1
  image:
    repository: redis
    tag: "7-alpine"
  service:
    type: ClusterIP
    port: 6379
  persistence:
    enabled: true
    size: 5Gi
    storageClass: "local-path"

# Web Configuration
web:
  replicas: 2
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      cpu: 2000m
      memory: 2Gi
{% if nautobot_git_packages is defined and nautobot_git_packages | length > 0 %}
  # Extended delays for Git plugin installation (5-8 min)
  livenessProbe:
    initialDelaySeconds: 600
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 3
  readinessProbe:
    initialDelaySeconds: 480
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 3
{% endif %}

# Worker Configuration
worker:
  replicas: 2
  resources:
    requests:
      cpu: 500m
      memory: 1Gi
    limits:
      cpu: 2000m
      memory: 2Gi
{% if nautobot_git_packages is defined and nautobot_git_packages | length > 0 %}
  # Extended delays for Git plugin installation
  livenessProbe:
    initialDelaySeconds: 600
  readinessProbe:
    initialDelaySeconds: 480
{% endif %}

# Scheduler Configuration
scheduler:
  replicas: 1
  resources:
    requests:
      cpu: 250m
      memory: 512Mi
    limits:
      cpu: 1000m
      memory: 1Gi
{% if nautobot_git_packages is defined and nautobot_git_packages | length > 0 %}
  # Extended delays for Git plugin installation
  livenessProbe:
    initialDelaySeconds: 600
  readinessProbe:
    initialDelaySeconds: 480
{% endif %}

# Service Configuration
service:
  type: LoadBalancer
  port: 8000
  annotations: {}

# Ingress Configuration
ingress:
  enabled: true
  className: nginx
  annotations:
    cert-manager.io/cluster-issuer: "selfsigned-issuer"
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
    nginx.ingress.kubernetes.io/proxy-body-size: "100m"
  hosts:
    - host: nautobot.local
      paths:
        - path: /
          pathType: Prefix
  tls:
    - secretName: nautobot-tls
      hosts:
        - nautobot.local
  # Default backend for direct IP access
  defaultBackend:
    enabled: true

# Persistence
persistence:
  enabled: true
  storageClass: "local-path"
  media:
    size: 10Gi
    accessMode: ReadWriteOnce
  static:
    size: 2Gi
    accessMode: ReadWriteOnce

# Monitoring - ServiceMonitor for Prometheus
monitoring:
  serviceMonitor:
    enabled: true
    interval: 30s
  prometheusRule:
    enabled: true
